# AndLinux defaults. Do not edit this file.
# Override any value in ~/.config/andlinux/config.env (Termux side), then run
# `andlinux setup` again. Every setup step is idempotent.

# --- Container -------------------------------------------------------------
# proot-distro container name.
AL_CONTAINER=andlinux
# Ubuntu LTS release. 24.04 is the default because it is the release the
# proot-distro maintainers recommend for desktops. 26.04 works but needs a
# recent Termux proot (see docs/decisions/0002-ubuntu-release.md).
AL_UBUNTU_RELEASE=24.04
# OCI image reference. Empty means "ubuntu:${AL_UBUNTU_RELEASE}" from Docker Hub
# (the Canonical-maintained official image). Pin by digest for reproducibility,
# for example: ubuntu:24.04@sha256:<digest>
AL_IMAGE=
# Fallback when the registry is unreachable or rate-limited: Canonical's
# ubuntu-base tarball from cdimage.ubuntu.com (latest point release).
AL_IMAGE_FALLBACK=ubuntu-base
# Ubuntu apt mirror for arm64. Empty keeps the official ports.ubuntu.com.
# Example (Korea, carries ubuntu-ports): https://ftp.kaist.ac.kr/ubuntu-ports/
AL_UBUNTU_MIRROR=
# 1 = fetch Ubuntu packages over HTTPS (apt verifies signatures either way).
AL_APT_HTTPS=0
# PEM file (Termux path) of an extra root CA, for TLS-inspecting corporate
# proxies. Proxy variables (HTTPS_PROXY, ...) set in Termux are forwarded.
AL_EXTRA_CA_FILE=

# --- Profile ---------------------------------------------------------------
# cli     : base, user, Android bridges, dev tools, Claude Code, SSH
# desktop : cli + XFCE, Korean input/fonts, Firefox, VS Code
# full    : desktop + code-server, Google Chrome, cloudflared, Go/Rust/Java
AL_PROFILE=desktop
# Space-separated module names to add to or remove from the profile.
AL_MODULES_EXTRA=
AL_MODULES_SKIP=
# Ubuntu 25.10+ defaults to sudo-rs, which has broken under proot before.
# auto = switch the sudo alternative to classic sudo on 25.10 and newer.
# (rust-coreutils stays: 26.04's build-essential depends on it.)
AL_CLASSIC_SUDO=auto

# --- User and locale -------------------------------------------------------
# Non-root user. Claude Code refuses --dangerously-skip-permissions as root.
AL_USER=dev
# System language. Korean fonts and the Hangul input method are installed
# regardless; this only changes message and UI language.
AL_LANG=en_US.UTF-8
# Extra locales to generate (space-separated).
AL_LOCALES="en_US.UTF-8 ko_KR.UTF-8"
# Empty means "use the Android device timezone", falling back to Asia/Seoul.
AL_TZ=

# --- Claude Code -----------------------------------------------------------
# native : official installer, self-updating in the background (Anthropic default)
# apt    : official signed apt repository, updated by `andlinux update`
AL_CLAUDE_METHOD=native
# latest | stable (about one week old, skips releases with major regressions)
AL_CLAUDE_CHANNEL=latest
# permissions.defaultMode written to ~/.claude/settings.json. Empty leaves it
# alone (Claude Code's own default). Options: default, acceptEdits, plan, auto,
# dontAsk, bypassPermissions. bypassPermissions lets Claude touch everything the
# Termux app can reach, shared storage included (docs/architecture.md).
AL_CLAUDE_DEFAULT_MODE=

# --- Dev tools -------------------------------------------------------------
# Global tools installed through mise for the dev user.
AL_MISE_TOOLS="node@lts uv@latest"
# Additional mise tools for the full profile.
AL_MISE_TOOLS_FULL="go@latest java@temurin-25 rust@stable"

# --- Services --------------------------------------------------------------
# SSH into the Ubuntu guest (Dropbear; OpenSSH sshd crashes proot).
AL_SSH_PORT=2222
# 127.0.0.1 keeps SSH local; 0.0.0.0 exposes it to LAN and Tailscale.
AL_SSH_LISTEN=0.0.0.0
AL_CODE_SERVER_PORT=8080
AL_CODE_SERVER_LISTEN=127.0.0.1
# Services to start at boot through the Termux:Boot app (e.g. "ssh").
AL_BOOT_SERVICES=

# --- Desktop ---------------------------------------------------------------
AL_DISPLAY=:1
# none   : software rendering (llvmpipe), works on every device
# virgl  : virglrenderer-android (ANGLE) in Termux, portable acceleration
AL_GPU=none
# Where Android-visible downloads go (empty disables the redirect).
AL_ANDROID_DOWNLOADS=/sdcard/Download

# --- Backups ---------------------------------------------------------------
# Shared storage survives uninstalling Termux.
AL_BACKUP_DIR=/sdcard/AndLinux/backups
AL_BACKUP_KEEP=3
# Optional rclone remote path, e.g. gdrive:claude5/AndLinux/backups
AL_BACKUP_RCLONE_REMOTE=
